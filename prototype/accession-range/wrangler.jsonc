{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bted-catalogue-v03-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "../../dist/worker-site",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "BTED_DB",
      "database_name": "bted-catalogue-v03-preview",
      "database_id": "fed55acc-5093-44e7-b672-f1e0a347ba5d"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN_HOST": "huggingface.co"
  }
}
