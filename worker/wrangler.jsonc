{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bted",
  "account_id": "406a94b19dd8bd8d9e851f8c5ed3a569",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../dist/worker-site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "BTED_DB",
      "database_name": "bted-catalog",
      "database_id": "c304fae8-cce6-4fc1-922d-e3bbc1c9b995",
      "migrations_dir": "../database/migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN_HOST": "huggingface.co",
    "BTED_ANALYTICS": "on",
    "BTED_RUNTIME_FIELDS": "on",
    "BTED_D1_ONLY": "on",
    "BTED_COLLECTION_REVISION": "deffa4a7183f71a8b47b3c44-v6",
    "BTED_METADATA_REVISION": "9f81698a3cee64f4eaf90b90cd36d640f38d9315",
    "BTED_ANNOTATION_REVISION": "2acf28d9cf0a276f05e6a1456d56c92ccc2292b7"
  },
  "triggers": { "crons": ["20 3 * * *"] }
}
